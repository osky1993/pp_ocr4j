# pp-ocr4j 运行环境配置（被 bin/start.sh 与 systemd 读取）
# 修改后：sudo systemctl restart pp-ocr4j

# JVM 参数：堆 2G 起步即可，ONNX Runtime 的模型与推理内存在堆外（native），
# 整机预算 ≈ Xmx + 1~2G native；内存紧张时优先调小 ocr.concurrency 而不是压堆
JAVA_OPTS="-Xms512m -Xmx2g -XX:+ExitOnOutOfMemoryError -Duser.timezone=Asia/Shanghai"

# java 可执行文件（默认取 PATH 中的 java；需要指定 JDK 时改为绝对路径）
JAVA_BIN="java"

# Spring profile：prod 关闭 /api/ocr/demo 演示接口
SPRING_PROFILES_ACTIVE="prod"

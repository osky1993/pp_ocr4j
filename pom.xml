<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>pp-ocr4j</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>pp-ocr4j</name>
    <description>Spring Boot 3.x + mica-ppocr（PP-OCRv6 Java 原生 OCR）示例项目</description>

    <properties>
        <java.version>17</java.version>
        <mica.ppocr.version>1.0.1</mica.ppocr.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- mica-ppocr：PP-OCRv6 的 Java 17 原生实现，纯 ONNX Runtime 推理，
             OpenCV / ONNX Runtime 原生库由 Maven 自动拉取 -->
        <dependency>
            <groupId>net.dreamlu</groupId>
            <artifactId>mica-ppocr-spring-boot-starter</artifactId>
            <version>${mica.ppocr.version}</version>
        </dependency>
        <!-- 可观测性：健康/就绪探针 + Prometheus 指标 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- NVIDIA CUDA 构建（Linux/Windows）：mvn -Pgpu package
             把 mica-ppocr 传递的 CPU 版 onnxruntime 换成 onnxruntime_gpu（含 CUDA EP 原生库），
             运行时配 ocr.accelerator: cuda（或 auto）。环境要求：CUDA 12.x + cuDNN 9。
             注意 onnxruntime_gpu 无 macOS 原生库，本 profile 不能在 Mac 上运行。 -->
        <profile>
            <id>gpu</id>
            <dependencies>
                <dependency>
                    <groupId>net.dreamlu</groupId>
                    <artifactId>mica-ppocr-spring-boot-starter</artifactId>
                    <version>${mica.ppocr.version}</version>
                    <exclusions>
                        <exclusion>
                            <groupId>com.microsoft.onnxruntime</groupId>
                            <artifactId>onnxruntime</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>com.microsoft.onnxruntime</groupId>
                    <artifactId>onnxruntime_gpu</artifactId>
                    <version>1.26.0</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!-- 生成 build-info.properties，供 /api/ocr/info 返回组件版本 -->
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                        <configuration>
                            <additionalProperties>
                                <mica-ppocr>${mica.ppocr.version}</mica-ppocr>
                            </additionalProperties>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
